---
layout: layouts/base.njk
permalink: /gallery.html
title: Galeria - Banda RPA
---

<section class="py-14 md:py-20 px-4">
  <div class="max-w-6xl mx-auto text-center">
    <p class="text-zinc-500 uppercase tracking-[0.3em] text-sm">Nossos momentos</p>
    <h3 class="[font-family:'Anton_SC'] relative inline-block z-[1] text-5xl md:text-6xl text-white uppercase mt-3 after:absolute after:content-[''] after:bottom-0 after:left-0 after:-z-[1] after:h-3.5 after:w-full after:bg-[#990000]">Galeria</h3>

    <div id="galeria-grid" class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {% for foto in gallery %}
        <a href="{{ foto.src }}" data-glightbox="galeria" {% if foto.caption %}data-title="{{ foto.caption }}"{% endif %} class="group relative block aspect-square overflow-hidden rounded-md border border-zinc-800 shadow-2xl grayscale hover:grayscale-0 transition duration-300 ease-in-out focus:outline-none focus:ring-2 focus:ring-[#990000]">
          <img src="{{ foto.src }}" alt="{{ foto.alt }}" loading="lazy" class="w-full h-full object-cover transition duration-300 ease-in-out group-hover:scale-105">
        </a>
      {% endfor %}
    </div>
  </div>
</section>