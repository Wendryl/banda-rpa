---
layout: layouts/base.njk
permalink: /index.html
---

{% block extraHead %}
<link rel="preload" as="image" type="image/avif" href="./optimized/hero-1280.avif" imagesrcset="./optimized/hero-640.avif 640w, ./optimized/hero-960.avif 960w, ./optimized/hero-1280.avif 1280w" imagesizes="100vw" fetchpriority="high">
{% endblock %}

<section id="home" class="relative flex flex-col items-center justify-center text-center py-8">
  <picture class="block absolute inset-0 w-full h-full">
    <source type="image/avif" srcset="./optimized/hero-640.avif 640w, ./optimized/hero-960.avif 960w, ./optimized/hero-1280.avif 1280w" sizes="100vw">
    <source type="image/webp" srcset="./optimized/hero-640.webp 640w, ./optimized/hero-960.webp 960w, ./optimized/hero-1280.webp 1280w" sizes="100vw">
    <img src="./gallery/gallery-010.jpeg" alt="" aria-hidden="true" width="1280" height="1280" fetchpriority="high" decoding="async" class="w-full h-full object-cover">
  </picture>
  <div class="absolute inset-0 bg-black/75"></div>
  <div class="relative z-10 flex flex-col items-center max-w-3xl mx-auto">
    <div class="max-w-[400px]">
      <picture class="block">
        <source type="image/avif" srcset="./optimized/logo-400.avif 400w, ./optimized/logo-800.avif 800w" sizes="(min-width: 400px) 400px, 100vw">
        <source type="image/webp" srcset="./optimized/logo-400.webp 400w, ./optimized/logo-800.webp 800w" sizes="(min-width: 400px) 400px, 100vw">
        <img src="./logo.png" alt="Logo da banda RPA" width="800" height="533" fetchpriority="high" decoding="async" class="w-full h-full object-cover">
      </picture>
    </div>
    <h1 class="[font-family:'Anton_SC'] text-5xl md:text-8xl text-white mt-10 uppercase">Banda Rpa</h1>
    <h2 class="[font-family:'Anton_SC'] relative inline-block z-[1] text-2xl md:text-4xl text-zinc-200 mt-3 uppercase after:absolute after:content-[''] after:bottom-[2px] after:left-0 after:-z-[1] after:h-2 after:w-full after:bg-[#990000]">Reunidos Para Adorar</h2>
    <div class="flex items-center gap-4 mt-10">
      {% for item in site.social %}
        {% set icon = site.icons[item.icon] %}
        <a href="{{ item.href }}" target="_blank" aria-label="{{ item.label }}" class="w-12 h-12 rounded-full bg-zinc-800 hover:bg-[#990000] transition duration-200 ease-in-out flex items-center justify-center">
          {% include "partials/svg.njk" %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<section id="agenda" class="py-20 px-4">
  <div class="max-w-3xl mx-auto text-center">
    <p class="text-zinc-400 uppercase tracking-[0.3em] text-sm">Save the date</p>
    <h3 class="[font-family:'Anton_SC'] relative inline-block z-[1] text-5xl md:text-6xl text-white uppercase mt-3 after:absolute after:content-[''] after:bottom-0 after:left-0 after:-z-[1] after:h-3.5 after:w-full after:bg-[#990000]">Agenda</h3>
    <p class="text-zinc-400 uppercase tracking-[0.3em] text-sm mt-3">Save the date</p>

    <div class="mt-14 space-y-6">
      {% for show in agenda.shows | upcoming %}
        <div class="relative text-left bg-zinc-900 border rounded-md shadow-2xl{% if show.date | isToday %} border-[#990000] shadow-[0_0_35px_rgba(153,0,0,0.4)]{% else %} border-zinc-800{% endif %}">
          {% if show.date | isToday %}
          <span class="absolute top-6 right-6 md:top-8 md:right-8 inline-flex items-center gap-2 bg-[#990000] text-white text-xs uppercase tracking-[0.2em] px-3 py-1.5 rounded-full">
            <span class="relative flex size-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
              <span class="relative inline-flex size-2 rounded-full bg-white"></span>
            </span>
            Hoje
          </span>
          {% endif %}
          <div class="p-8 md:p-12">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-zinc-800 pb-8">
              <div>
                <h4 class="[font-family:'Anton_SC'] text-6xl text-[#e53935] uppercase leading-none">{{ show.date | diaMes }}</h4>
                <h4 class="[font-family:'Anton_SC'] text-2xl text-white uppercase mt-3">{{ show.city }}</h4>
              </div>
              {% if show.venue %}<div class="flex gap-4 text-sm max-w-md">
                <span class="text-white uppercase shrink-0">Local:</span>
                <span class="text-zinc-400">{{ show.venue }}</span>
              </div>{% endif %}
            </div>
          </div>
        </div>
      {% else %}
        <p class="text-zinc-400 uppercase tracking-wide">Em breve divulgaremos novas datas</p>
      {% endfor %}
    </div>
  </div>
</section>

<section id="musicas" class="py-20 px-4 bg-zinc-950 border-y border-zinc-800">
  <div class="max-w-3xl mx-auto text-center">
    <h3 class="[font-family:'Anton_SC'] relative inline-block z-[1] text-5xl text-white uppercase after:absolute after:content-[''] after:bottom-0 after:left-0 after:-z-[1] after:h-3.5 after:w-full after:bg-[#990000]">Músicas</h3>
    <p class="text-zinc-400 mt-5 mb-10 uppercase tracking-wide">Ouça a banda</p>
    <div id="youtube-facade" data-video="XXxy-IPth9c" role="button" tabindex="0" aria-label="Reproduzir vídeo da banda no YouTube" class="group relative w-full aspect-video rounded-md shadow-2xl border border-zinc-800 overflow-hidden cursor-pointer">
      <img src="./optimized/youtube-poster-1280.webp" srcset="./optimized/youtube-poster-640.webp 640w, ./optimized/youtube-poster-1280.webp 1280w" sizes="(min-width: 768px) 768px, 100vw" alt="Banda RPA em apresentação" width="1280" height="720" loading="lazy" decoding="async" class="w-full h-full object-cover transition duration-300 ease-in-out group-hover:scale-105">
      <span class="absolute inset-0 flex items-center justify-center">
        <span class="flex items-center justify-center size-16 md:size-20 rounded-full bg-[#990000] group-hover:bg-[#e53935] transition duration-300 ease-in-out shadow-2xl">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 md:size-10 text-white translate-x-0.5" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        </span>
      </span>
    </div>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-10">
      {% for item in site.musicas %}
        {% set icon = site.icons[item.icon] %}
        <a href="{{ site.links[item.hrefKey] }}" target="_blank" class="flex items-center gap-2 border border-zinc-700 hover:border-[#990000] hover:text-white transition duration-200 ease-in-out px-6 py-3 uppercase text-sm hover:bg-[#990000]">
          {% include "partials/svg.njk" %}
          {{ item.label }}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<section id="contato" class="py-20 px-4 text-center">
  <div class="max-w-3xl mx-auto">
    <p class="text-zinc-400 uppercase tracking-[0.3em] text-sm">Agende um show</p>
    <h3 class="[font-family:'Anton_SC'] relative inline-block z-[1] text-4xl md:text-5xl text-white uppercase mt-3 after:absolute after:content-[''] after:bottom-0 after:left-0 after:-z-[1] after:h-3.5 after:w-full after:bg-[#990000]">Contato para eventos</h3>
    <a href="{{ site.links.whatsapp }}" target="_blank" class="inline-flex items-center justify-center gap-3 bg-[#990000] hover:bg-zinc-800 transition duration-200 ease-in-out text-white px-10 py-4 mt-12 uppercase text-lg shadow-2xl">
      {% set icon = site.icons.whatsapp %}
      <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="size-6">
        {% for d in icon.paths %}<path d="{{ d }}" />{% endfor %}
      </svg>
      Whatsapp
    </a>
  </div>
</section>

{% block extraScripts %}
<script>
  (function () {
    var facade = document.getElementById("youtube-facade");
    if (!facade) return;
    function load() {
      var id = facade.getAttribute("data-video");
      var iframe = document.createElement("iframe");
      iframe.src = "https://www.youtube.com/embed/" + id + "?autoplay=1&rel=0";
      iframe.title = "YouTube video player";
      iframe.setAttribute("allow", "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share");
      iframe.setAttribute("referrerpolicy", "strict-origin-when-cross-origin");
      iframe.setAttribute("allowfullscreen", "");
      iframe.className = "w-full h-full border-0";
      facade.replaceChildren(iframe);
    }
    facade.addEventListener("click", load, { once: true });
    facade.addEventListener("keydown", function (event) {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        load();
      }
    }, { once: true });
  })();
</script>
{% endblock %}